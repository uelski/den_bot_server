# Copy to .env and fill in. Never commit .env.

# --- Gemini ---
# Required. Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override of the chat model used by graph nodes.
GEMINI_MODEL=gemini-2.5-flash

# --- Qdrant ---
# Local Docker default is http://localhost:6333; use Qdrant Cloud URL in prod.
QDRANT_URL=http://localhost:6333
# Required only when connecting to Qdrant Cloud. Leave blank for local.
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=denver_gis_catalog
# PDF knowledge-base collection (written by the worker, searched by the
# retriever alongside the catalog). Must match the worker's QDRANT_KB_COLLECTION_NAME.
QDRANT_KB_COLLECTION_NAME=denver_pdf_knowledge_base

# --- Cohere rerank (merges catalog + PDF KB retrieval results) ---
# Required for the reranker node (app/graph/nodes/reranker.py). Free-tier key
# from https://dashboard.cohere.com. When unset the reranker fails open — it
# falls back to the fused retrieval order instead of cross-encoder reranking,
# so /query keeps working but ranking quality across the two collections drops.
COHERE_API_KEY=
# Optional: override the rerank model (default rerank-english-v3.0).
COHERE_RERANK_MODEL=rerank-english-v3.0

# --- LangSmith (optional — enables tracing) ---
# Get a key from https://smith.langchain.com/ and set these three to enable
# automatic tracing of every graph run. When LANGCHAIN_TRACING_V2 is unset or
# "false", LangChain / LangGraph run with zero tracing overhead.
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=denver-rag-dev

# --- RTD GTFS-realtime feeds (optional overrides) ---
# All three feeds are publicly accessible and don't require an API key.
# RTD_USER_AGENT is shared across all RTD requests; set it to identify your
# project (RTD's terms request a descriptive UA — same convention as NWS).
# Cache TTL is shared between the arrivals and vehicle-positions tools; the
# alerts feed has its own (RTD_ALERTS_CACHE_TTL_SECONDS, default 300).
RTD_ALERTS_URL=https://open-data.rtd-denver.com/files/gtfs-rt/rtd/Alerts.pb
RTD_TRIPUPDATES_URL=https://open-data.rtd-denver.com/files/gtfs-rt/rtd/TripUpdate.pb
RTD_VEHICLES_URL=https://open-data.rtd-denver.com/files/gtfs-rt/rtd/VehiclePosition.pb
RTD_REALTIME_CACHE_TTL_SECONDS=30
RTD_USER_AGENT=blue-cypher-denver-rag (you@example.com)

# --- Tavily web search (powers the search_denver_gov agent tool) ---
# Required for search_denver_gov. Get a key at https://app.tavily.com.
# When unset, the tool returns an `error` field and the LLM falls back to
# answering without denvergov.org context.
TAVILY_API_KEY=
# Optional: how long to cache identical denvergov.org search results.
# Defaults to 86400 (24 hours). Tavily charges per query; raise/lower based
# on freshness needs vs. cost.
TAVILY_CACHE_TTL_SECONDS=86400

# --- Redis (backs the LangGraph checkpointer for multi-turn memory) ---
# Local default points at the docker-compose Redis service on port 6381
# (chosen to avoid collisions with other local Redis instances on the
# standard 6379). For prod, swap to a managed Redis URL (Upstash, Cloud
# Memorystore, etc.) — code path unchanged. When REDIS_URL is unset the
# API runs without checkpointer (single-turn fallback; thread_id in /query
# body is accepted but no memory is loaded/saved across requests).
REDIS_URL=redis://localhost:6381
# Optional: how many messages from prior turns to send into the generator
# prompt. Defaults to 8 (≈4 user + 4 assistant exchanges). The full history
# always lives in Redis; this only controls the slice sent to the LLM.
MEMORY_HISTORY_TURNS=8
# Optional: how long to keep checkpointed thread state in Redis before
# auto-expiry. Defaults to 30 days (in minutes). Set to 0 to disable TTL.
MEMORY_TTL_MINUTES=43200

# --- CORS ---
# Comma-separated list of allowed origins for the /query SSE endpoint.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://bluecypher.ai,https://www.bluecypher.ai

# --- Admin (PDF Knowledge Base upload flow) ---
# Required for /admin/* endpoints. Shared secret the frontend sends in the
# X-Admin-Password header; constant-time compared server-side. If unset,
# /admin/* returns 503 (we refuse to silently accept any password).
ADMIN_PASSWORD=
# Required for /admin/pdf-upload-url. The GCS bucket signed URLs are issued
# against. The deployed service account needs storage.objects.create on this
# bucket, plus iam.serviceAccountTokenCreator on itself for v4 URL signing.
GCS_UPLOAD_BUCKET=
