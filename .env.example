# Copy to .env and fill in. Never commit .env.

# --- Gemini ---
# Required. Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override of the chat model used by graph nodes.
GEMINI_MODEL=gemini-2.5-flash

# --- Qdrant ---
# Local Docker default is http://localhost:6333; use Qdrant Cloud URL in prod.
QDRANT_URL=http://localhost:6333
# Required only when connecting to Qdrant Cloud. Leave blank for local.
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=denver_gis_catalog

# --- LangSmith (optional — enables tracing) ---
# Get a key from https://smith.langchain.com/ and set these three to enable
# automatic tracing of every graph run. When LANGCHAIN_TRACING_V2 is unset or
# "false", LangChain / LangGraph run with zero tracing overhead.
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=denver-rag-dev

# --- RTD GTFS-realtime feeds (optional overrides) ---
# All three feeds are publicly accessible and don't require an API key.
# RTD_USER_AGENT is shared across all RTD requests; set it to identify your
# project (RTD's terms request a descriptive UA — same convention as NWS).
# Cache TTL is shared between the arrivals and vehicle-positions tools; the
# alerts feed has its own (RTD_ALERTS_CACHE_TTL_SECONDS, default 300).
RTD_ALERTS_URL=https://open-data.rtd-denver.com/files/gtfs-rt/rtd/Alerts.pb
RTD_TRIPUPDATES_URL=https://open-data.rtd-denver.com/files/gtfs-rt/rtd/TripUpdate.pb
RTD_VEHICLES_URL=https://open-data.rtd-denver.com/files/gtfs-rt/rtd/VehiclePosition.pb
RTD_REALTIME_CACHE_TTL_SECONDS=30
RTD_USER_AGENT=blue-cypher-denver-rag (you@example.com)

# --- Tavily web search (powers the search_denver_gov agent tool) ---
# Required for search_denver_gov. Get a key at https://app.tavily.com.
# When unset, the tool returns an `error` field and the LLM falls back to
# answering without denvergov.org context.
TAVILY_API_KEY=
# Optional: how long to cache identical denvergov.org search results.
# Defaults to 86400 (24 hours). Tavily charges per query; raise/lower based
# on freshness needs vs. cost.
TAVILY_CACHE_TTL_SECONDS=86400

# --- CORS ---
# Comma-separated list of allowed origins for the /query SSE endpoint.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
