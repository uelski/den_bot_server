# Keep the Cloud Run image small — everything below is dev/build/data and not
# needed at runtime. The Dockerfile only COPY's requirements.txt and app/.

# VCS / IDE
.git
.gitignore
.github
.vscode
.idea
.DS_Store

# Python
.den_venv
__pycache__
*.py[cod]
*.pyo
*.egg-info

# Local secrets / config
.env
.env.local
.env.production
.env.development
.env.test
.env.*.local

# Tests
tests
pytest.ini

# Migration + ops artifacts
snapshots
phase1_inventory.txt
qdrant_storage

# Local Docker
docker-compose.yml

# Docs / planning (live in repo, not in runtime image)
*.md
graph.mmd
graph.png
notes.txt

# Data files — ingest-time only; runtime reads from Qdrant.
# Exception: the ACS neighborhood geojson is loaded by app/neighborhoods/resolver.py
# at startup to populate OFFICIAL_NAMES. Keep it in the build context.
data
*.geojson
*.csv
*.zip
ODC_*
!data/ODC_POP_ACS20172021NBRHDCOMMON.geojson
# RTD static GTFS lookup tables used by app/tools/_rtd_static.py to enrich
# realtime feeds (route_id → "W Line", stop_id → name/coords, trip_id → route).
# The rest of the GTFS bundle (shapes.txt, stop_times.txt, calendar*) is unused
# at runtime and stays excluded.
!data/rtd_gtfs/stops.txt
!data/rtd_gtfs/routes.txt
!data/rtd_gtfs/trips.txt

# One-off ingest + utility scripts; not invoked from the app at runtime
scripts
