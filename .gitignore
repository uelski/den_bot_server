# RTD GTFS data — large, replaceable from the public download.
# Exception: the three lookup tables (stops/routes/trips) are read by
# app/tools/_rtd_static.py at runtime to enrich realtime feeds, so they're
# committed (~1.8 MB) and baked into the Cloud Run image.
data/rtd_gtfs/*
!data/rtd_gtfs/stops.txt
!data/rtd_gtfs/routes.txt
!data/rtd_gtfs/trips.txt
data/google_transit.zip

# Denver parks geojson — replaceable from the Denver Open Data Catalog hub
# (search "Park Boundary" on opendata-geospatialdenver.hub.arcgis.com).
data/ODC_PARK_PARKLAND_A_*.geojson

